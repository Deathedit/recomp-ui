# Writes files into a C++ source as byte arrays (the fonts):
#
#   cmake -DOUT=<file.cpp> -DNAMESPACE=<ns> -DFILES="<NAME>=<path>;..." -P embed_files.cmake
#
# Each NAME becomes `extern const unsigned char NAME[]` and `extern const
# size_t NAME_SIZE` in NAMESPACE.
set(TEXT "// Generated by cmake/embed_files.cmake from the files below: do not edit.\n#include <cstddef>\n\nnamespace ${NAMESPACE}\n{\n")
foreach(ENTRY ${FILES})
    string(FIND "${ENTRY}" "=" EQUALS)
    string(SUBSTRING "${ENTRY}" 0 ${EQUALS} NAME)
    math(EXPR START "${EQUALS} + 1")
    string(SUBSTRING "${ENTRY}" ${START} -1 PATH)
    file(READ "${PATH}" HEX HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
    get_filename_component(FILE_NAME "${PATH}" NAME)
    string(APPEND TEXT "    // ${FILE_NAME}\n    extern const unsigned char ${NAME}[] = {${BYTES}};\n    extern const size_t ${NAME}_SIZE = sizeof(${NAME});\n")
endforeach()
string(APPEND TEXT "}\n")
file(WRITE "${OUT}" "${TEXT}")
